      object daSQL1: TdaSQL
        CollationType = ctASCII
        DatabaseName = 'dbdados'
        DatabaseType = dtInterBase
        DataPipelineName = 'CTARECEBERCAIXA'
        IsCaseSensitive = True
        LinkColor = clMaroon
        LinkType = ltMagicSQL
        MaxSQLFieldAliasLength = 25
        SQLText.Strings = (
          'SELECT CTARECEBERCAIXA_1.ACORDO, '
          '       CTARECEBERCAIXA_1.AVISOS, '
          '       CTARECEBERCAIXA_1.CAIXA, '
          '       CTARECEBERCAIXA_1.CDBANCO, '
          '       CTARECEBERCAIXA_1.CDCAIXAORIGEM, '
          '       CTARECEBERCAIXA_1.CDCLIENTE, '
          '       CTARECEBERCAIXA_1.CDRECGRUPO, '
          '       CTARECEBERCAIXA_1.CDUSR, '
          '       CTARECEBERCAIXA_1.CDVEND, '
          '       CTARECEBERCAIXA_1.CODPAGTO, '
          '       CTARECEBERCAIXA_1.CONTROLE, '
          '       CTARECEBERCAIXA_1.DESCONTO, '
          '       CTARECEBERCAIXA_1.DIVIDA, '
          '       CTARECEBERCAIXA_1.DTALTER, '
          '       CTARECEBERCAIXA_1.DTCOB, '
          '       CTARECEBERCAIXA_1.DTLOG, '
          '       CTARECEBERCAIXA_1.DTMOV, '
          '       CTARECEBERCAIXA_1.DTVENC, '
          '       CTARECEBERCAIXA_1.HISTORICO, '
          '       CTARECEBERCAIXA_1.HORALOG, '
          '       CTARECEBERCAIXA_1.IDEMPRESA, '
          '       CTARECEBERCAIXA_1.INTERVALO, '
          '       CTARECEBERCAIXA_1.JUROS, '
          '       CTARECEBERCAIXA_1.LANCAMENTO, '
          '       CTARECEBERCAIXA_1.NRBOLETO, '
          '       CTARECEBERCAIXA_1.NRDOC, '
          '       CTARECEBERCAIXA_1.NRDOC2, '
          '       CTARECEBERCAIXA_1.NRPEDIDO, '
          '       CTARECEBERCAIXA_1.ORIGEM, '
          '       CTARECEBERCAIXA_1.PARCELA, '
          '       CTARECEBERCAIXA_1.PERCVEND, '
          '       CTARECEBERCAIXA_1.PGCOMISSAO, '
          '       CTARECEBERCAIXA_1.RETENCAO, '
          '       CTARECEBERCAIXA_1.SIST_ALT, '
          '       CTARECEBERCAIXA_1.STATUS, '
          '       CTARECEBERCAIXA_1.TOTALPG, '
          '       CTARECEBERCAIXA_1.TPPAGTO, '
          '       CTARECEBERCAIXA_1.VALOR, '
          '       CTARECEBERCAIXA_1.VERIFICA'
          'FROM CTARECEBERCAIXA CTARECEBERCAIXA_1'
          '      INNER JOIN SAIDAESTOQUE SAIDAESTOQUE_1 ON '
          '     (SAIDAESTOQUE_1.IDEMPRESA = CTARECEBERCAIXA_1.IDEMPRESA)'
          '      AND (SAIDAESTOQUE_1.NRPEDIDO = CTARECEBERCAIXA_1.NRPEDIDO)'
          '      INNER JOIN CTARECEBER_PROV CTARECEBER_PROV_1 ON '
          '     (CTARECEBER_PROV_1.NRPEDIDO = SAIDAESTOQUE_1.NRPEDIDO)'
          
            '      AND (CTARECEBER_PROV_1.IDEMPRESA = SAIDAESTOQUE_1.IDEMPRES' +
            'A)'
          '      AND (CTARECEBER_PROV_1.VALOR = SAIDAESTOQUE_1.VALOR)')
        SQLType = sqSQL2
