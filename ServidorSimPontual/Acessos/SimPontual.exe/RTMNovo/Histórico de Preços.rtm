      object daSQL1: TdaSQL
        CollationType = ctASCII
        DatabaseName = 'dbdados'
        DatabaseType = dtInterBase
        DataPipelineName = 'HISTORICO_PRECO'
        IsCaseSensitive = True
        LinkColor = clMaroon
        LinkType = ltMagicSQL
        MaxSQLFieldAliasLength = 25
        SQLText.Strings = (
          'SELECT PRODUTO_1.PRODUTO, '
          '       PRODUTOPRECO_HISTORICO_1.CDPRODUTO, '
          '       PRODUTOPRECO_HISTORICO_1.IDPRECO, '
          '       PRODUTOPRECO_HISTORICO_1.CDUNIDADE, '
          '       PRODUTOPRECO_HISTORICO_1.PRECO, '
          '       PRODUTOPRECO_HISTORICO_1.DTREAJUSTE, '
          '       PRODUTOPRECO_1.PRECO PRECO_2, '
          '       TABELAPRECO_1.DESCRICAO'
          'FROM PRODUTO PRODUTO_1'
          
            '      INNER JOIN PRODUTOPRECO_HISTORICO PRODUTOPRECO_HISTORICO_1' +
            ' ON '
          '     (PRODUTOPRECO_HISTORICO_1.CDPRODUTO = PRODUTO_1.CDPRODUTO)'
          '      INNER JOIN PRODUTOPRECO PRODUTOPRECO_1 ON '
          
            '     (PRODUTOPRECO_1.CDPRODUTO = PRODUTOPRECO_HISTORICO_1.CDPROD' +
            'UTO)'
          
            '      AND (PRODUTOPRECO_1.IDPRECO = PRODUTOPRECO_HISTORICO_1.IDP' +
            'RECO)'
          
            '      AND (PRODUTOPRECO_1.CDUNIDADE = PRODUTOPRECO_HISTORICO_1.C' +
            'DUNIDADE)'
          '      INNER JOIN TABELAPRECO TABELAPRECO_1 ON '
          '     (TABELAPRECO_1.IDPRECO = PRODUTOPRECO_HISTORICO_1.IDPRECO)'
          'ORDER BY PRODUTOPRECO_HISTORICO_1.CDPRODUTO, '
          '         PRODUTOPRECO_HISTORICO_1.IDPRECO, '
          '         PRODUTOPRECO_HISTORICO_1.CDUNIDADE, '
          '         PRODUTOPRECO_HISTORICO_1.DTREAJUSTE DESC')
        SQLType = sqSQL2
